PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=usta_takvimi

# Public origin of this API. Uploaded images are stored as PUBLIC_API_URL + /uploads/<file>.
PUBLIC_API_URL=http://localhost:4000
# Where uploaded images are written (default: ./uploads). On cPanel use a path outside the app folder.
# UPLOAD_DIR=/home/CPANELUSER/usta-uploads

# Comma-separated frontend origins allowed by CORS. Empty = allow all (development only).
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Required when NODE_ENV=production (the API refuses to start without them).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# APP_TOKEN_SECRET=
